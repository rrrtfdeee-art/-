# =====================================================================
# NSW Syndication Server — Render Environment Variables (.env.example)
# =====================================================================
# انسخ هذه المتغيرات إلى تبويب Environment (Group: admind) في Render:

# ─────────────────────────────────────────────────────────────
# 1. متغيرات النظام والتحكم الأساسية المعتمدة مسبقاً (الـ 8 الأساسية):
# ─────────────────────────────────────────────────────────────
ADMIN_CHAT_ID=
TELEGRAM_BOT_TOKEN=
NSW_GAS_WEBAPP_URL=
SCHEDULE_SPREADSHEET_ID=
REWAYAT_TOKEN=
REWAYAT_USERNAME=
WATTPAD_USERNAME=
WATTPAD_PASSWORD=

# بديل اختياري لتوكن نادي الروايات وواتباد
REWAYAT_CLUB_TOKEN=
WATTPAD_TOKEN=

# ─────────────────────────────────────────────────────────────
# 2. قواعد بيانات Supabase المركزية (بديل مستودعات GitHub القديمة):
# ─────────────────────────────────────────────────────────────
# قاعدة البيانات العربية المركزية (novels و chapters):
SUPABASE_URL_AR=https://your-ar-project.supabase.co
SUPABASE_KEY_AR=your_supabase_ar_service_role_key

# للتوافق الخلفي مع supabase_db.py و backup_engine.py:
SUPABASE_URL=https://your-ar-project.supabase.co
SUPABASE_KEY=your_supabase_ar_service_role_key

# قاعدة البيانات الإنجليزية المركزية (novels_en و chapters_en):
SUPABASE_URL_EN=https://your-en-project.supabase.co
SUPABASE_KEY_EN=your_supabase_en_service_role_key

# ─────────────────────────────────────────────────────────────
# 3. إعدادات اختيارية:
# ─────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_BACKUP_REPO=rrrtfdeee-art/back
PORT=8501
